{
  "name": "despues",
  "version": "1.0.0",
  "description": "UNA Chat — Versión asegurada con testing automatizado",
  "main": "server.js",
  "engines": {
    "node": "20 || >=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha test/test.js test/unit/**/*.test.js",
    "test:unit": "mocha test/test.js test/unit/**/*.test.js",
    "test:integration": "mocha test/integration/**/*.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-openid-connect": "^3.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "mocha": "^12.0.3",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.4"
  }
}
