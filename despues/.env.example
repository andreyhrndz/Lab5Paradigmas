# ==============================================================================
# UNA Chat — Variables de Entorno (Laboratorio 8 - US-01 Auth0)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el directorio actual (despues/):
#    cp .env.example .env
# 2. Rellena los valores con los datos de tu aplicación en Auth0 Dashboard.
# 3. NUNCA hagas commit del archivo .env con credenciales reales.
# ==============================================================================

# Puerto local del servidor HTTP
PORT=3000

# Secreto criptográfico de sesión para cifrado JWE de cookies (mínimo 32 caracteres)
# Generar una clave aleatoria segura, por ejemplo ejecutando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=cambiar_por_un_secreto_criptografico_aleatorio_minimo_32_caracteres

# URL base de la aplicación (sin barra final)
# En ambiente local: http://localhost:3000
# En despliegue Vercel: https://tu-proyecto.vercel.app
AUTH0_BASE_URL=http://localhost:3000

# Client ID de tu Regular Web Application creada en Auth0 Dashboard
AUTH0_CLIENT_ID=tu_client_id_de_auth0_aqui

# Issuer Base URL de tu tenant en Auth0
# Formato: https://<tu-tenant>.auth0.com o https://<tu-tenant>.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://tu-tenant.auth0.com

# Client Secret de Auth0 (requerido para Regular Web Application con intercambio de código)
AUTH0_CLIENT_SECRET=tu_client_secret_de_auth0_aqui

# Conexión social preferida (opcional, por defecto 'google-oauth2')
AUTH0_CONNECTION=google-oauth2
